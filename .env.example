NEXT_PUBLIC_SITE_URL=https://milkywayy.com
NEXT_PUBLIC_SITE_ENV=staging
NEXT_PUBLIC_CLIENT_LOGIN_URL=/client-login
NEXT_PUBLIC_CAL_LINK=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
REVALIDATE_SECRET=
# Optional, server-only: overrides the Supabase URL for public reads (the fallback test uses it).
SUPABASE_SERVER_URL=
# Not used yet (direct video upload to Bunny is a later step; videos are links for now).
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
LEAD_STORE=supabase
# Server-only. Lets /api/lead save through the database's submit_lead() (its SHA-256 is stored in
# private.app_secrets). Generate with: openssl rand -hex 32
LEAD_SECRET=
# Leads per visitor per 10 minutes (default 6).
LEAD_RATE_LIMIT=
LEAD_WEBHOOK_URL=
# Lead emails (Resend). Without RESEND_API_KEY nothing is emailed.
RESEND_API_KEY=
LEAD_EMAIL_TO=hello@milkywayy.com
# Set once milkywayy.com is verified in Resend, e.g. Milkywayy <website@milkywayy.com>;
# until then alerts go from onboarding@resend.dev and visitors get no confirmation email.
LEAD_EMAIL_FROM=
# Monitoring (Phase 8). Alerts are live in production; ALERTS=on turns them on elsewhere.
ALERTS=
ALERT_EMAIL_TO=
# Weekly leads email: Vercel Cron sends CRON_SECRET; REPORT_SECRET reads the leads (hash in
# private.app_secrets under 'report'). Generate each with: openssl rand -hex 32
CRON_SECRET=
REPORT_SECRET=
# Tracking: "on" (production default), "test" (debug mode + Meta test code), "off" (staging/local default).
NEXT_PUBLIC_TRACKING=
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_TOKEN=
# Events Manager → Test events code (only used in test mode).
META_TEST_EVENT_CODE=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_CLARITY_ID=

# Local only (Playwright): admin test accounts. Never set these on Vercel.
E2E_OWNER_EMAIL=
E2E_OWNER_PASSWORD=
E2E_EDITOR_EMAIL=
E2E_EDITOR_PASSWORD=
E2E_STRANGER_EMAIL=
E2E_STRANGER_PASSWORD=
# Client portal while it's built in its own Supabase project (portal branch only). Empty = the
# website's project. E2E_PORTAL_SECRET: the portal tests' key to the dev-only helpers.
NEXT_PUBLIC_PORTAL_SUPABASE_URL=
NEXT_PUBLIC_PORTAL_SUPABASE_ANON_KEY=
E2E_PORTAL_SECRET=
# Admin → Client accounts reaches the portal project through gated database functions
# (hash in private.app_secrets under 'portal_admin'). Server-only. Generate: openssl rand -hex 32
PORTAL_ADMIN_SECRET=
# Sign-in codes in English: our server ↔ the send-sms hook / otp-feedback Edge Functions
# (hash in private.app_secrets under 'portal_hook'; same value as the Edge Function secret).
PORTAL_HOOK_SECRET=
