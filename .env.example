NEXT_PUBLIC_SITE_URL=https://milkywayy.com
NEXT_PUBLIC_SITE_ENV=staging
NEXT_PUBLIC_WHATSAPP_NUMBER=971507263306
NEXT_PUBLIC_CLIENT_LOGIN_URL=/client-login
NEXT_PUBLIC_CAL_LINK=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
REVALIDATE_SECRET=
# Optional, server-only: overrides the Supabase URL for public reads (the fallback test uses it).
SUPABASE_SERVER_URL=
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
ADMIN_ALLOWED_EMAILS=hello@milkywayy.com
LEAD_STORE=supabase
# Server-only. Lets /api/lead save through the database's submit_lead() (its SHA-256 is stored in
# private.app_secrets). Generate with: openssl rand -hex 32
LEAD_SECRET=
# Leads per visitor per 10 minutes (default 6).
LEAD_RATE_LIMIT=
LEAD_WEBHOOK_URL=
# Lead emails (Resend). Without RESEND_API_KEY nothing is emailed.
RESEND_API_KEY=
LEAD_EMAIL_TO=hello@milkywayy.com
# Set once milkywayy.com is verified in Resend, e.g. Milkywayy <website@milkywayy.com>;
# until then alerts go from onboarding@resend.dev and visitors get no confirmation email.
LEAD_EMAIL_FROM=
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_TOKEN=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_CLARITY_ID=

# Local only (Playwright): admin test accounts. Never set these on Vercel.
E2E_OWNER_EMAIL=
E2E_OWNER_PASSWORD=
E2E_EDITOR_EMAIL=
E2E_EDITOR_PASSWORD=
E2E_STRANGER_EMAIL=
E2E_STRANGER_PASSWORD=
